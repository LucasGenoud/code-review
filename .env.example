# Folder containing your git repos. Projects can only be added from inside it.
# Docker sets this to /repos; for `npm run dev` copy this file to .env.local.
REPO_ROOT=C:\git

# SQLite location. Defaults to ./data
# DATA_DIR=./data

# Code sandbox job folder, shared with `node sandbox/runner.mjs`.
# Outside Docker the runner has NO isolation: code runs as you.
# SANDBOX_DIR=./data/sandbox
